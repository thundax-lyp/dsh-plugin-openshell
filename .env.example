COMPOSE_FILE=deploy/compose.yaml

# Absolute path to private JSON with "host" and "socket" for an authenticated SSH master.
DSH_OPENSHELL_CONNECTION=

# Optional SSH destination and password for a temporary master.
# Leave the password empty to authenticate with SSH keys.
DSH_OPENSHELL_SSH_HOST=
DSH_OPENSHELL_SSH_PASSWORD=

# Validation host OpenShell installation root. Relative to the remote user's home.
# Requires bin/openshell and gateway.toml.
DSH_OPENSHELL_REMOTE_HOME=openshell

# Optional trusted mirror/cache for Compose builds and validation (Node.js 24).
# Leave empty to use the Dockerfile default (pinned public image digest).
DSH_OPENSHELL_NODE_IMAGE=

# Runtime image reference used both for build and official sandbox creation.
DSH_OPENSHELL_RUNTIME_IMAGE=dsh-sandbox-openshell-runtime:0.2.1-rc.4

# Build-time network only; this does not change sandbox egress policy.
DSH_OPENSHELL_BUILD_NETWORK=default

# One-shot Compose deployment into an existing OpenShell Gateway (Linux x64).
DSH_OPENSHELL_GATEWAY_ENDPOINT=http://127.0.0.1:18080
DSH_OPENSHELL_WORKSPACE=default
DSH_OPENSHELL_SANDBOX=dsh-openshell
DSH_OPENSHELL_DEPLOY_TIMEOUT=120
# Empty uses ./runtime/bin/openshell (official Linux x64 CLI 0.1.6).
DSH_OPENSHELL_CLI_PATH=
# Empty uses ./runtime/openshell-credentials; keep an empty directory for HTTP.
# For mTLS: ca.crt, tls.crt, tls.key. Real credentials stay outside Git.
DSH_OPENSHELL_CREDENTIALS_DIR=
