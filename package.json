{
    "name": "dsh-sandbox-openshell",
    "version": "0.1.0-rc.1",
    "type": "module",
    "packageManager": "pnpm@12.15.0",
    "engines": {
        "node": "^22.19.0 || >=24.0.0"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "pnpm typecheck && pnpm lint && pnpm format:check",
        "test": "node --experimental-strip-types tests/sandbox/provider.test.mjs && node --experimental-strip-types tests/subprocess/interactive.test.mjs && node --experimental-strip-types tests/fs/provider.test.mjs && node tests/deploy/compose.test.mjs && node tests/deploy/bootstrap.test.mjs",
        "test:remote": "node scripts/prepare-official-sdk.mjs && node --experimental-strip-types tests/e2e/remote.test.mjs",
        "build": "node scripts/build.mjs",
        "test:mtls": "node scripts/prepare-official-sdk.mjs && node --experimental-strip-types tests/e2e/remote.test.mjs --mtls-only",
        "prepack": "node scripts/build.mjs",
        "prepublishOnly": "pnpm check && pnpm test",
        "test:package": "node tests/package/installed.test.mjs"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.20.5",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.10",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1"
    },
    "dependencies": {
        "@deepseek-ai/cordis": "4.0.5",
        "@deepseek-ai/dsh-attachment": "0.2.1-rc.4",
        "@deepseek-ai/dsh-fs": "0.2.1-rc.4",
        "@deepseek-ai/dsh-sandbox": "0.2.1-rc.4",
        "@deepseek-ai/dsh-subprocess": "0.2.1-rc.4",
        "@deepseek-ai/dsh-subprocess-local": "0.2.1-rc.4",
        "@deepseek-ai/dsh-working-directory": "0.2.1-rc.4"
    },
    "overrides": {
        "zod": "4.6.6",
        "undici": "8.12.2"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./runtime/confine.mjs": "./dist/runtime/confine.mjs",
        "./runtime/fs.mjs": "./dist/runtime/fs.mjs",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "docs"
    ],
    "description": "DSH filesystem, subprocess and workspace providers for an OpenShell sandbox",
    "license": "UNLICENSED",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/thundax-lyp/dsh-plugin-openshell.git"
    },
    "homepage": "https://github.com/thundax-lyp/dsh-plugin-openshell#readme",
    "bugs": {
        "url": "https://github.com/thundax-lyp/dsh-plugin-openshell/issues"
    },
    "keywords": [
        "dsh",
        "openshell",
        "sandbox",
        "provider"
    ],
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public",
        "tag": "rc"
    }
}
